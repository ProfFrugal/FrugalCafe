<Window x:Class="Weiqi.MainWindow"  
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
       Title="Weiqi" Height="800" Width="800">  
   <Grid>  
       <Canvas Name="GoBoard" Background="BurlyWood" Margin="10">  
           <!-- Vertical lines -->  
           <ItemsControl ItemsSource="{Binding}" Canvas.Left="0">  
               <ItemsControl.ItemsPanel>  
                   <ItemsPanelTemplate>  
                       <Canvas />  
                   </ItemsPanelTemplate>  
               </ItemsControl.ItemsPanel>  
               <ItemsControl.ItemTemplate>  
                   <DataTemplate>  
                       <Line X1="{Binding}" Y1="10" X2="{Binding}" Y2="750" Stroke="Black" StrokeThickness="1" />  
                   </DataTemplate>  
               </ItemsControl.ItemTemplate>  
           </ItemsControl>  
       </Canvas>  
   </Grid>  
</Window>
